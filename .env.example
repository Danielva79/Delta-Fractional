# Copie este archivo como .env para desarrollo local. Ningún secreto va en el repo.
# En GitHub, estas variables se configuran en Settings → Secrets and variables → Actions.

# URL pública del sitio (canonical, hreflang, Open Graph y sitemap)
PUBLIC_SITE_URL=https://deltafractional.com

# Ruta base. "/" en producción; "/delta-fractional-preview/" para la vista previa.
BASE_PATH=/

# "true" agrega noindex a todas las páginas (vista previa).
PUBLIC_NOINDEX=

# Analítica: Umami Cloud (sin cookies). Si está vacío, no se carga ningún script.
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js

# Formulario de contacto: Web3Forms (detrás de features.formularioContacto).
# La clave de Web3Forms es pública por diseño: solo permite enviar al correo con el que se creó.
# El correo de destino (pendiente) se registra en Web3Forms al crear la clave, no aquí.
# Si está vacía, el formulario no se muestra aunque la bandera esté activa.
PUBLIC_WEB3FORMS_KEY=

# "true" agrega el hCaptcha de Web3Forms al formulario (actívelo también en el panel de Web3Forms).
# Sin él quedan el campo trampa y el tiempo mínimo de 3 s.
PUBLIC_WEB3FORMS_HCAPTCHA=
