---
// Página interna de revisión: NO se indexa y queda fuera del sitemap.
// Muestra los slots de fotos y, en las fases siguientes, los componentes futuros
// (caso, testimonios, logos, curso, formulario) con datos de ejemplo.
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Caso from '../components/futuros/Caso.astro';
import Testimonios from '../components/futuros/Testimonios.astro';
import LogosClientes from '../components/futuros/LogosClientes.astro';
import Curso from '../components/futuros/Curso.astro';
import TablaTraduccion from '../components/TablaTraduccion.astro';
import FormularioContacto from '../components/futuros/FormularioContacto.astro';
import { faltantesPrivacidad } from '../lib/privacidad';
import { ruta } from '../lib/enlaces';
import { contenido } from '../lib/contenido';
import { casoEjemplo, testimoniosEjemplo, logosEjemplo, cursoEjemplo } from '../content/ejemplos';
import type { IdFoto } from '../content/schema';

const c = contenido('es');
const slots = Object.keys(c.fotos) as IdFoto[];
---
<Base c={c} ruta="/vista-interna/" alternos={{ es: '/', en: '/en/' }} titulo="Vista interna · Delta Fractional" noindex>
  <section class="seccion">
    <div class="wrap">
      <p class="eyebrow">Solo para revisión</p>
      <h1 class="titulo">Vista interna</h1>
      <p class="sub">Página sin indexar. Muestra el estado de cada slot de foto: con el archivo en la carpeta fotos/, la foto optimizada; sin él, el marcador de marca.</p>
      <h2 class="h2">Slots de fotos</h2>
      <div class="rejilla">
        {slots.map((id) => {
          const f = c.fotos[id];
          return (
            <figure>
              <Photo c={c} id={id} sizes="(max-width: 900px) 100vw, 380px" class="slot" />
              {!f.placeholder && <div class="sin-marcador" style={`aspect-ratio:${f.ratio}`}>Sin marcador: sin foto no se muestra nada.</div>}
              <figcaption class="small">
                <strong>{id}</strong> · {f.ratio} · {f.tratamiento} · archivo: fotos/{f.archivo}<br />
                alt: {f.alt === null ? 'pendiente' : f.alt === '' ? '(decorativa)' : f.alt}
              </figcaption>
            </figure>
          );
        })}
      </div>

      <h2 class="h2">Componentes ocultos, con datos de ejemplo</h2>
      <p class="sub">En las páginas públicas cada uno aparece solo cuando su bandera en <code>features</code> está en <code>true</code> y hay contenido real aprobado. Los textos de abajo son de ejemplo.</p>
    </div>
  </section>

  <div class="wrap"><p class="etiqueta">features.caso · va después de "Cómo trabajo"</p></div>
  <Caso c={c} caso={casoEjemplo} />
  <div class="wrap"><p class="etiqueta">features.testimonios · va después del caso</p></div>
  <Testimonios c={c} testimonios={testimoniosEjemplo} />
  <div class="wrap"><p class="etiqueta">features.logosClientes · va dentro de la barra de prueba</p></div>
  <div class="franja"><div class="wrap"><LogosClientes c={c} logos={logosEjemplo} /></div></div>
  <div class="wrap"><p class="etiqueta">features.curso · va en la banda del diagnóstico</p></div>
  <div class="band-dark franja-oscura"><div class="wrap"><div class="curso"><Curso c={c} curso={cursoEjemplo} /></div></div></div>

  <div class="wrap"><p class="etiqueta">features.formularioContacto · va al lado de los botones del cierre. Envío simulado: no sale nada.</p></div>
  <div class="band-dark franja-oscura"><div class="wrap"><div class="demo-form"><FormularioContacto c={c} clave="demo" endpoint="simulado-ok" /></div></div></div>

  <section class="seccion" aria-labelledby="h-privacidad">
    <div class="wrap">
      <h2 id="h-privacidad" class="h2">Aviso de privacidad</h2>
      <p class="sub">Texto base para revisión de un abogado. La página pública no existe hasta completar: {faltantesPrivacidad(c).join('; ')}.</p>
      <p class="enlaces-aviso">
        <a class="enlace-flecha" href={ruta('/vista-interna/privacidad/')}>Ver el aviso en español (vista interna)</a>
        <a class="enlace-flecha" href={ruta('/vista-interna/privacy/')}>Ver el aviso en inglés (vista interna)</a>
      </p>
    </div>
  </section>
  <TablaTraduccion />
</Base>

<style>
  .titulo { margin: var(--space-3) 0 var(--space-4); font-size: var(--fs-h2); }
  .h2 { margin: var(--space-8) 0 var(--space-5); font-size: var(--fs-h3); }
  .rejilla { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr)); gap: var(--space-6); align-items: start; }
  figure { display: flex; flex-direction: column; gap: var(--space-3); }
  figure :global(.slot) { border-radius: var(--radius-lg); }
  .sin-marcador {
    display: grid; place-items: center; padding: var(--space-4); text-align: center;
    border: 1.5px dashed var(--line-strong); border-radius: var(--radius-lg); color: var(--ink-2); font-size: var(--fs-small);
  }
  figcaption { color: var(--ink-2); }
  .etiqueta {
    display: block; margin-top: var(--space-8); margin-bottom: var(--space-5); max-width: none;
    font-size: var(--fs-small); font-weight: var(--fw-semibold); color: var(--ink-2);
  }
  .franja { background: var(--surface); padding: var(--space-5) 0 var(--space-6); }
  .franja-oscura { padding: var(--space-8) 0; margin-bottom: var(--space-8); }
  .curso { max-width: 420px; }
  .demo-form { max-width: 480px; }
  .enlaces-aviso { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); margin-top: var(--space-4); max-width: none; }
  code { font-size: 0.9em; }
</style>
