---
// /politica-datos/: política de tratamiento de datos (Ley 1581 de 2012) del autodiagnóstico.
// Solo existe con features.autodiagnostico. Mientras sea borrador: aviso visible, sin indexar
// y fuera del sitemap; los datos que faltan se ven como [PENDIENTE: …].
import Base from '../../layouts/Base.astro';
import { contenido } from '../../lib/contenido';
import { politica, rellenarPolitica, RUTA_POLITICA } from '../../lib/autodiagnostico/contenido';

export function getStaticPaths() {
  return contenido('es').features.autodiagnostico ? [{ params: { p: undefined } }] : [];
}

const c = contenido('es');
const r = (t: string) => rellenarPolitica(t, c);
---
<Base c={c} ruta={RUTA_POLITICA} alternos={{ es: RUTA_POLITICA, en: '/en/' }} soloUnIdioma titulo={`${politica.titulo} | ${c.marca.nombre}`} descripcion={politica.titulo} noindex={politica.borrador}>
  <article class="seccion">
    <div class="wrap texto-legal">
      {politica.borrador && <p class="aviso-revision" role="note">{politica.avisoRevision}</p>}
      <h1>{politica.titulo}</h1>
      {politica.secciones.map((s) => (
        <section>
          <h2>{s.h2}</h2>
          {s.parrafos?.map((p) => <p>{r(p)}</p>)}
          {s.lista && <ul>{s.lista.map((i) => <li>{r(i)}</li>)}</ul>}
        </section>
      ))}
    </div>
  </article>
</Base>

<style>
  .texto-legal { max-width: calc(760px + 2 * var(--page-margin)); }
  h1 { font-size: var(--fs-h2); line-height: var(--lh-h2); margin: var(--space-5) 0 var(--space-7); }
  section { margin-top: var(--space-7); }
  h2 { font-size: var(--fs-h3); line-height: var(--lh-h3); margin-bottom: var(--space-3); }
  p, li { color: var(--ink); }
  p + p { margin-top: var(--space-3); }
  ul { margin: var(--space-3) 0 0; padding-left: 1.2em; display: flex; flex-direction: column; gap: var(--space-2); }
  .aviso-revision {
    display: inline-block; font-size: var(--fs-small); font-weight: var(--fw-semibold); color: var(--ink);
    background: var(--surface); border-left: 4px solid var(--accent); padding: var(--space-2) var(--space-4); border-radius: var(--radius-sm);
  }
</style>
