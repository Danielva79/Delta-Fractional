---
// /blog/<slug>/: un artículo (solo en español), con datos estructurados BlogPosting y cierre con los dos botones.
import Base from '../../layouts/Base.astro';
import Icono from '../../components/Icono.astro';
import { contenido } from '../../lib/contenido';
import { ruta, absoluta, botonPrincipal, botonWhatsApp } from '../../lib/enlaces';
import { articulos, textosBlog as t, fechaLarga, RUTA_BLOG, type Articulo } from '../../lib/blog';

export function getStaticPaths() {
  return articulos.map((a) => ({ params: { slug: a.slug }, props: { a } }));
}

const { a } = Astro.props as { a: Articulo };
const c = contenido('es');
const { Content } = a;
const principal = botonPrincipal(c);
const whats = botonWhatsApp(c);
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: a.titulo,
  description: a.descripcion,
  datePublished: a.fecha,
  inLanguage: 'es-CO',
  mainEntityOfPage: absoluta(a.ruta, Astro.site),
  image: absoluta(c.meta.ogImage, Astro.site),
  author: { '@type': 'Person', name: c.marca.persona, url: absoluta('/', Astro.site) },
  publisher: { '@type': 'Organization', name: c.marca.nombre, url: absoluta('/', Astro.site) },
};
---
<Base c={c} ruta={a.ruta} alternos={{ es: a.ruta, en: '/en/' }} titulo={a.tituloSeo} descripcion={a.descripcion} soloUnIdioma>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />
  <article class="seccion">
    <div class="wrap">
      <header class="cabeza">
        <a class="small volver" href={ruta(RUTA_BLOG)}>{t.volver}</a>
        <h1>{a.titulo}</h1>
        <p class="small muted">{t.autor} · <time datetime={a.fecha}>{fechaLarga(a.fecha)}</time> · {a.lectura} {t.lectura}</p>
      </header>
      <div class="cuerpo">
        <Content />
      </div>
    </div>
  </article>
  <section class="seccion band-dark cierre" aria-labelledby="h-cierre-blog">
    <div class="wrap">
      <h2 id="h-cierre-blog">{t.cierre.h2}</h2>
      <p class="texto">{t.cierre.texto}</p>
      <div class="botones">
        <a class="btn btn-primario" href={principal.href} data-evento={principal.evento} data-ubicacion="blog">{principal.texto}</a>
        <a class="btn btn-secundario" href={whats.href} target="_blank" rel="noopener" data-evento={whats.evento} data-ubicacion="blog">
          <Icono nombre="message-circle" tamano={20} />{whats.texto}<span class="sr-only">, {c.ui.pestanaNueva}</span>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .cabeza, .cuerpo { max-width: 720px; }
  .cabeza { display: flex; flex-direction: column; gap: var(--space-3); margin-bottom: var(--space-7); }
  .volver { align-self: flex-start; display: inline-flex; align-items: center; min-height: var(--tap); }
  h1 { font-size: var(--fs-h2); line-height: var(--lh-h2); letter-spacing: var(--ls-h2); }
  .cuerpo :global(p), .cuerpo :global(li) { line-height: var(--lh-body); }
  .cuerpo :global(p) { margin-bottom: var(--space-4); }
  .cuerpo :global(h2) {
    font-size: var(--fs-h3); line-height: var(--lh-h3); letter-spacing: var(--ls-h3);
    margin: var(--space-7) 0 var(--space-4);
  }
  .cuerpo :global(ul), .cuerpo :global(ol) { margin: 0 0 var(--space-5); padding-left: 1.4em; max-width: 68ch; }
  .cuerpo :global(li + li) { margin-top: var(--space-2); }
  .cuerpo :global(strong) { color: var(--ink); font-weight: var(--fw-semibold); }
  .cuerpo :global(h2:last-of-type ~ ul) { font-size: var(--fs-small); color: var(--ink-2); }
  .cierre .texto { margin: var(--space-4) 0 var(--space-6); }
</style>
