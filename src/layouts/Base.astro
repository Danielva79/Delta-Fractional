---
// Layout común: <head> completo (SEO, OG, hreflang, fuentes, favicons), header y footer.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Contenido } from '../lib/contenido';
import { ruta, absoluta } from '../lib/enlaces';

interface Props {
  c: Contenido;
  /** Ruta de la página sin la base, p. ej. "/" o "/en/". */
  ruta: string;
  /** Rutas equivalentes en cada idioma (para hreflang y el selector ES/EN). */
  alternos: { es: string; en: string };
  titulo?: string;
  descripcion?: string;
  noindex?: boolean;
}
const { c, ruta: rutaPagina, alternos, titulo = c.meta.title, descripcion = c.meta.description } = Astro.props;
// La vista previa se construye con PUBLIC_NOINDEX=true: ninguna página se indexa.
const noindex = Astro.props.noindex || import.meta.env.PUBLIC_NOINDEX === 'true';
const site = Astro.site;
const canonical = absoluta(rutaPagina, site);
const og = absoluta(c.meta.ogImage, site);
const locale = c.idioma === 'es' ? 'es_CO' : 'en_US';
const localeAlterno = c.idioma === 'es' ? 'en_US' : 'es_CO';
// Umami Cloud (sin cookies): solo si existe el ID. data-domains evita contar la vista previa.
const umamiId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
const umamiSrc = import.meta.env.PUBLIC_UMAMI_SRC || 'https://cloud.umami.is/script.js';
const fuenteLatin = ruta('/fonts/Figtree-Variable-latin.woff2');
const fuenteExt = ruta('/fonts/Figtree-Variable-latin-ext.woff2');
// @font-face con la ruta base correcta (los rangos unicode son los de tokens.css del kit).
const fontFace = `
@font-face{font-family:"Figtree";font-style:normal;font-weight:300 900;font-display:swap;src:url("${fuenteLatin}") format("woff2");unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:"Figtree";font-style:normal;font-weight:300 900;font-display:swap;src:url("${fuenteExt}") format("woff2");unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C4,U+2113,U+2C60-2C7F,U+A720-A7FF}`;
---
<!doctype html>
<html lang={c.meta.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {/* Páginas que nunca se indexan (vista interna, 404): sin canonical ni hreflang. */}
    {!Astro.props.noindex && (
      <>
        <link rel="canonical" href={canonical} />
        <link rel="alternate" hreflang="es-CO" href={absoluta(alternos.es, site)} />
        <link rel="alternate" hreflang="en" href={absoluta(alternos.en, site)} />
        <link rel="alternate" hreflang="x-default" href={absoluta(alternos.es, site)} />
      </>
    )}

    <link rel="preload" href={fuenteLatin} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFace}></style>

    <link rel="icon" href={ruta('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={ruta('/favicon.ico')} sizes="48x48" />
    <link rel="apple-touch-icon" href={ruta('/apple-touch-icon.png')} />
    <link rel="manifest" href={ruta('/site.webmanifest')} />
    <meta name="theme-color" content="#2A3038" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Delta Fractional" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content={c.meta.ogImage.endsWith('.png') ? 'image/png' : 'image/jpeg'} />
    <meta property="og:image:alt" content={c.meta.ogImageAlt} />
    <meta property="og:locale" content={locale} />
    <meta property="og:locale:alternate" content={localeAlterno} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={og} />
    <meta name="twitter:image:alt" content={c.meta.ogImageAlt} />
    {umamiId && (
      <script is:inline defer src={umamiSrc} data-website-id={umamiId} data-domains="deltafractional.com" data-do-not-track="true"></script>
    )}
    <slot name="head" />
  </head>
  <body>
    <a class="saltar" href="#contenido">{c.ui.saltar}</a>
    <Header c={c} alternos={alternos} />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer c={c} />
    <slot name="despues" />
    <script>
      import '../scripts/analitica';
    </script>
  </body>
</html>
