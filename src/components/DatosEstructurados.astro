---
// Schema.org en JSON-LD: ProfessionalService + Person + FAQPage (solo las preguntas aprobadas).
// Sin aggregateRating, review ni dirección exacta. priceRange aprobado por Daniel.
import type { Contenido } from '../lib/contenido';
import { absoluta } from '../lib/enlaces';

interface Props { c: Contenido; ruta: string }
const { c, ruta } = Astro.props;
const site = Astro.site;
const url = absoluta('/', site);
const idNegocio = `${url}#negocio`;
const idPersona = `${url}#daniel-villegas`;

const negocio = {
  '@type': 'ProfessionalService',
  '@id': idNegocio,
  name: c.marca.nombre,
  url,
  logo: absoluta('/img/logo/delta-horizontal-color@2x.png', site),
  image: absoluta(c.meta.ogImage, site),
  description: c.meta.description,
  telephone: '+573102216863',
  priceRange: c.idioma === 'es' ? 'Desde COP 2 M mensuales' : 'From COP 2 M per month',
  address: { '@type': 'PostalAddress', addressLocality: 'Manizales', addressRegion: 'Caldas', addressCountry: 'CO' },
  areaServed: { '@type': 'Country', name: 'Colombia' },
  founder: { '@id': idPersona },
  employee: { '@id': idPersona },
  sameAs: [c.contacto.linkedin],
  ...(c.contacto.correo ? { email: c.contacto.correo } : {}),
};
const persona = {
  '@type': 'Person',
  '@id': idPersona,
  name: c.marca.persona,
  jobTitle: c.marca.cargo,
  worksFor: { '@id': idNegocio },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'EADA Business School' },
    { '@type': 'CollegeOrUniversity', name: 'Pontificia Universidad Javeriana' },
  ],
  sameAs: [c.contacto.linkedin],
};
const faq = {
  '@type': 'FAQPage',
  '@id': `${absoluta(ruta, site)}#preguntas`,
  inLanguage: c.meta.lang,
  mainEntity: c.faq.items.map((f) => ({
    '@type': 'Question',
    name: f.p,
    acceptedAnswer: { '@type': 'Answer', text: f.r },
  })),
};
const json = JSON.stringify({ '@context': 'https://schema.org', '@graph': [negocio, persona, faq] }).replace(/</g, '\\u003c');
---
<script type="application/ld+json" set:html={json} />
