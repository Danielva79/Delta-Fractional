---
// 7.10 Cierre: conversión. WhatsApp es el botón principal en esta banda.
// El formulario se agrega en la fase 6, detrás de features.formularioContacto.
import Icono from '../Icono.astro';
import type { Contenido } from '../../lib/contenido';
import { diagnostico, whatsapp, ruta } from '../../lib/enlaces';

interface Props { c: Contenido }
const { c } = Astro.props;
---
<section class="band-dark cierre" id="cierre" aria-labelledby="h-cierre" data-cierre>
  <img class="trama" src={ruta('/img/graficos/trama-alas.svg')} alt="" aria-hidden="true" width="357" height="318" loading="lazy" />
  <div class="wrap seccion">
    <div class="contenido">
      <h2 id="h-cierre">{c.cierre.h2}</h2>
      <p class="texto">{c.cierre.texto}</p>
      <div class="botones">
        <a class="btn btn-primario" href={whatsapp(c)} data-evento="cta_whatsapp_click" data-ubicacion="cierre"><Icono nombre="message-circle" />{c.ctaWhatsApp}</a>
        <a class="btn btn-secundario" href={diagnostico(c)} data-evento="cta_diagnostico_click" data-ubicacion="cierre">{c.ctaPrincipal}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .contenido { max-width: 720px; display: flex; flex-direction: column; gap: 20px; }
  .texto { font-size: var(--fs-sub); line-height: var(--lh-sub); }
</style>
