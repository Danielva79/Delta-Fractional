---
// 7.4 Cómo trabajo: tres servicios según el momento de la empresa, en escalera (el chevrón "sube" de paso
// en paso). Cada servicio muestra solo el rango de valor; el valor exacto por tamaño va en la propuesta
// comercial (Daniel, 2026-11-18). Proyectos va en tarjeta oscura. Los datos pendientes no se muestran.
import Icono from '../Icono.astro';
import type { Contenido } from '../../lib/contenido';
import { diagnostico, whatsapp, ruta, conAutodiagnostico, botonWhatsApp } from '../../lib/enlaces';

interface Props { c: Contenido }
const { c } = Astro.props;
const { inversion } = c.servicios;
---
<section class="seccion" id="como-trabajo" aria-labelledby="h-servicios">
  <div class="wrap">
    <div class="encabezado">
      {c.servicios.antetitulo && <p class="eyebrow">{c.servicios.antetitulo}</p>}
      <h2 id="h-servicios">{c.servicios.h2}</h2>
      {c.servicios.intro && <p class="sub">{c.servicios.intro}</p>}
    </div>
    <div class="escalera">
      {c.servicios.items.map((s) => {
        const esDiagnostico = s.id === 'diagnostico';
        return (
          <article class:list={['servicio', { 'band-dark': s.id === 'proyectos' }]} aria-labelledby={`servicio-${s.id}`}>
            <img class="chev" src={ruta('/img/graficos/chevron-bullet.svg')} alt="" width="22" height="18" loading="lazy" />
            <p class="eyebrow">{s.nivel}</p>
            <h3 id={`servicio-${s.id}`}>{s.titulo}</h3>
            {s.paraQuien && <p class="para-quien">{s.paraQuien}</p>}
            <p class="texto">{s.texto}</p>
            {s.precio && (
              <p class="precio-servicio">
                <span class="monto tnum">{s.precio}</span>
                {s.precioNota && <span class="precio-nota">{s.precioNota}</span>}
              </p>
            )}
            {s.resultado && (
              <p class="resultado"><strong>{c.ui.resultado}</strong><span>{s.resultado}</span></p>
            )}
            {esDiagnostico && conAutodiagnostico(c) ? (
              <a class="enlace-flecha accion" href={botonWhatsApp(c).href} data-evento="cta_whatsapp_click" data-ubicacion="servicios">{botonWhatsApp(c).texto}<Icono nombre="arrow-right" tamano={18} /></a>
            ) : esDiagnostico ? (
              <a class="enlace-flecha accion" href={diagnostico(c)} data-evento="cta_diagnostico_click" data-ubicacion="servicios">{c.ctaPrincipal}<Icono nombre="arrow-right" tamano={18} /></a>
            ) : (
              <a class="enlace-flecha accion" href={whatsapp(c)} data-evento="cta_whatsapp_click" data-ubicacion="servicios">{c.ctaWhatsApp}<Icono nombre="arrow-right" tamano={18} /></a>
            )}
          </article>
        );
      })}
    </div>
    <div class="inversion">
      <p class="muted small">
        {inversion.precio && <><strong class="precio tnum">{inversion.precio}</strong> </>}
        {inversion.iva && <>{inversion.iva} </>}{inversion.nota}
      </p>
      {conAutodiagnostico(c) && (
        <a class="btn btn-primario" href={ruta('/autodiagnostico/')} data-evento="cta_autodiagnostico_click" data-ubicacion="servicios">{c.cuestionario.cta}</a>
      )}
    </div>
  </div>
</section>

<style>
  .encabezado {
    display: flex; flex-direction: column; gap: var(--space-4);
    max-width: 760px; margin-bottom: clamp(32px, 4vw, 48px);
  }
  .escalera { display: grid; grid-template-columns: 1fr; gap: var(--gutter); }
  .servicio {
    background: var(--surface); border-radius: var(--radius-lg); padding: clamp(24px, 2.6vw, 36px);
    display: flex; flex-direction: column; gap: 14px;
  }
  .chev { width: 22px; height: auto; }
  .eyebrow { margin-top: var(--space-1); }
  .para-quien { color: var(--ink); font-weight: var(--fw-medium); }
  .texto { color: var(--ink-2); }
  .precio-servicio {
    display: flex; flex-direction: column; gap: 2px;
    border-left: 4px solid var(--accent); padding-left: var(--space-3);
  }
  .monto { font-size: var(--fs-sub); font-weight: var(--fw-bold); color: var(--ink); letter-spacing: -0.01em; }
  .precio-nota { font-size: var(--fs-small); line-height: var(--lh-small); color: var(--ink-2); }
  .resultado {
    padding-top: var(--space-4); border-top: 1px solid var(--line);
    font-size: var(--fs-small); line-height: var(--lh-small); display: flex; flex-direction: column;
  }
  .resultado strong { font-weight: var(--fw-semibold); color: var(--ink); }
  .resultado span { color: var(--ink-2); }
  .accion { margin-top: auto; }

  /* Proyectos: tarjeta oscura (band-dark da títulos, antetítulo y enlace; el fondo se fija aquí). */
  .servicio.band-dark { background: var(--dark); }
  .servicio.band-dark .para-quien,
  .servicio.band-dark .monto,
  .servicio.band-dark .resultado strong { color: var(--on-dark); }
  .servicio.band-dark .texto,
  .servicio.band-dark .precio-nota,
  .servicio.band-dark .resultado span { color: var(--on-dark-2); }
  .servicio.band-dark .precio-servicio { border-left-color: var(--accent-on-dark); }
  .servicio.band-dark .resultado { border-top-color: var(--line-on-dark); }

  /* En escritorio: bases alineadas y techos que suben un paso por tarjeta. */
  @media (min-width: 1024px) {
    .escalera { grid-template-columns: repeat(3, 1fr); grid-template-rows: 32px 32px auto; }
    .servicio:nth-child(1) { grid-row: 3 / 4; }
    .servicio:nth-child(2) { grid-row: 2 / 4; }
    .servicio:nth-child(n + 3) { grid-row: 1 / 4; }
  }
  .inversion {
    margin-top: clamp(32px, 4vw, 48px); padding-top: var(--space-5); border-top: 1px solid var(--line);
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-4) var(--space-6);
  }
  .inversion p { max-width: 640px; margin: 0; }
  .precio { font-weight: var(--fw-bold); color: var(--ink); }
</style>
