---
// Página de inicio (la misma para ES y EN; cambia el contenido).
// Orden aprobado: Promesa + CTA → Prueba → Soluciones → Recursos → Conversión.
import Base from '../layouts/Base.astro';
import Separador from './Separador.astro';
import BarraMovil from './BarraMovil.astro';
import Hero from './secciones/Hero.astro';
import Prueba from './secciones/Prueba.astro';
import Problema from './secciones/Problema.astro';
import Servicios from './secciones/Servicios.astro';
import Diferencial from './secciones/Diferencial.astro';
import DeltaBI from './secciones/DeltaBI.astro';
import Sobre from './secciones/Sobre.astro';
import BandaDiagnostico from './secciones/BandaDiagnostico.astro';
import Faq from './secciones/Faq.astro';
import Cierre from './secciones/Cierre.astro';
import Caso from './futuros/Caso.astro';
import Testimonios from './futuros/Testimonios.astro';
import DatosEstructurados from './DatosEstructurados.astro';
import { getImage } from 'astro:assets';
import { imagenDe, anchosDe } from '../lib/fotos';
import { contenido, type Idioma } from '../lib/contenido';

interface Props { idioma: Idioma }
const c = contenido(Astro.props.idioma);
const alternos = { es: '/', en: '/en/' };
const rutaPagina = c.idioma === 'es' ? '/' : '/en/';

// Precarga de la foto del hero (LCP) cuando exista: AVIF en los mismos anchos que usa Photo.astro.
const fotoHero = imagenDe(c, c.hero.foto);
const tamanosHero = '(max-width: 900px) min(420px, 100vw), 480px';
let srcsetHero = '';
if (fotoHero) {
  const anchos = anchosDe(fotoHero);
  const imgs = await Promise.all(anchos.map((w) => getImage({ src: fotoHero, width: w, format: 'avif' })));
  srcsetHero = imgs.map((im, i) => `${im.src} ${anchos[i]}w`).join(', ');
}
---
<Base c={c} ruta={rutaPagina} alternos={alternos}>
  <DatosEstructurados c={c} ruta={rutaPagina} slot="head" />
  {srcsetHero && (
    <link slot="head" rel="preload" as="image" type="image/avif" imagesrcset={srcsetHero} imagesizes={tamanosHero} fetchpriority="high" />
  )}
  <Hero c={c} />
  <Prueba c={c} />
  <Problema c={c} />
  <Separador />
  <Servicios c={c} />
  {c.features.caso && <Caso c={c} caso={c.caso} />}
  {c.features.testimonios && <Testimonios c={c} testimonios={c.testimonios} />}
  <Diferencial c={c} />
  <DeltaBI c={c} />
  <Sobre c={c} />
  <BandaDiagnostico c={c} />
  <Faq c={c} />
  <Cierre c={c} />
  <BarraMovil c={c} slot="despues" />
</Base>
